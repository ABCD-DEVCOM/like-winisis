like_winisis_help_title=Syntaxe supportée (combinable avec AND, OR, NOT):
like_winisis_help_p=<b>?p(vXX)</b> ou <b>?a(vXX)</b>: Présence ou absence du champ
like_winisis_help_mfn=<b>?mfn>XX</b> ou <b>?mfn<XX</b>: Filtre relationnel par MFN
like_winisis_help_str=<b>?vXX:"texte"</b>: Recherche de chaîne (utilisez <b>v0</b> pour tout)
like_winisis_help_comb=<b>?v10:"Maria" AND v20:"Brésil"</b>: Combinaison booléenne
like_winisis_help_str_range=<b>?*10,125 v0:"Petrarca"</b>: Limite de plage MFN
like_winisis_reset_btn=Effacer les résultats